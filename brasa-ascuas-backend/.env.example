MONGODB_URI=mongodb://localhost:27017/brasa-ascuas
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Stripe — opcional. Si se deja el placeholder, el backend arranca igual y la
# app usa el pago simulado (POST /payments/simulate).
# Clave secreta: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Lo imprime `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PORT=3000
FRONTEND_URL=http://localhost:8100
